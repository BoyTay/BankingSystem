<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.banking.ui.NovaBankAccountsController"
            prefHeight="940.0" prefWidth="1440.0"
            stylesheets="@novabank.css" styleClass="main-window">


    <!-- ==================== 2. MAIN WORKSPACE ==================== -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="24.0" styleClass="content-container">
                <padding>
                    <Insets top="28.0" right="36.0" bottom="36.0" left="36.0"/>
                </padding>

                <ComboBox fx:id="cbAllAccounts" promptText="Chon tai khoan" maxWidth="Infinity" styleClass="filter-dropdown-pill"/>

                <!-- ROW 1: TOP HORIZONTAL ACCOUNT CARDS (Everyday Standard, Nova Savings, Premium Reserve) -->
                <HBox fx:id="boxAccountCards" spacing="20.0">

                    <!-- Card 1: Everyday Standard (Selected) -->
                    <VBox fx:id="cardStandard" styleClass="account-overview-card,account-card-selected" HBox.hgrow="ALWAYS" spacing="12.0" onMouseClicked="#selectStandardAccount">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <StackPane styleClass="acc-color-indicator,indicator-green"/>
                            <VBox spacing="2.0">
                                <Label text="Everyday Standard" styleClass="acc-title-bold"/>
                                <Label text="STANDARD" styleClass="acc-sub-num"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="VND" styleClass="status-badge-active"/>
                        </HBox>
                        <VBox spacing="4.0">
                            <Label text="Available balance" styleClass="acc-meta-label"/>
                            <Label fx:id="lblCard1Balance" text="0 VND" styleClass="acc-balance-large"/>
                        </VBox>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Tài khoản chuẩn" styleClass="acc-meta-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblCard1Selected" text="Selected" styleClass="acc-selected-badge"/>
                        </HBox>
                    </VBox>

                    <!-- Card 2: Nova Savings -->
                    <VBox fx:id="cardSavings" styleClass="account-overview-card" HBox.hgrow="ALWAYS" spacing="12.0" onMouseClicked="#selectSavingsAccount">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <StackPane styleClass="acc-color-indicator,indicator-blue"/>
                            <VBox spacing="2.0">
                                <Label text="Nova Savings" styleClass="acc-title-bold"/>
                                <Label text="SAVINGS" styleClass="acc-sub-num"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="VND" styleClass="status-badge-active"/>
                        </HBox>
                        <VBox spacing="4.0">
                            <Label text="Available balance" styleClass="acc-meta-label"/>
                            <Label fx:id="lblCard2Balance" text="0 VND" styleClass="acc-balance-large"/>
                        </VBox>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Tài khoản tiết kiệm" styleClass="acc-meta-label"/>
                        </HBox>
                    </VBox>

                    <!-- Card 3: Premium Reserve -->
                    <VBox fx:id="cardPremium" styleClass="account-overview-card" HBox.hgrow="ALWAYS" spacing="12.0" onMouseClicked="#selectPremiumAccount">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <StackPane styleClass="acc-color-indicator,indicator-amber"/>
                            <VBox spacing="2.0">
                                <Label text="Premium Reserve" styleClass="acc-title-bold"/>
                                <Label text="PREMIUM" styleClass="acc-sub-num"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblCard3Status" text="—" styleClass="status-badge-active"/>
                        </HBox>
                        <VBox spacing="4.0">
                            <Label text="Available balance" styleClass="acc-meta-label"/>
                            <Label fx:id="lblCard3Balance" text="0 VND" styleClass="acc-balance-large"/>
                        </VBox>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Tài khoản cao cấp" styleClass="acc-meta-label"/>
                        </HBox>
                    </VBox>

                </HBox>

                <!-- ROW 2: DETAILS WORKSPACE (Left 65% + Right 35%) -->
                <HBox spacing="24.0">

                    <!-- LEFT COLUMN: Account Details + Account Settings -->
                    <VBox HBox.hgrow="ALWAYS" spacing="24.0">

                        <!-- Account Details Card -->
                        <VBox styleClass="card" spacing="18.0">
                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="2.0">
                                    <Label fx:id="lblDetailAccountTitle" text="Everyday Standard" styleClass="transfer-form-headline"/>
                                    <Label fx:id="lblDetailAccountDesc" text="Primary checking account" styleClass="card-hint"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblDetailStatusBadge" text="● Active" styleClass="status-badge-active"/>
                            </HBox>

                            <!-- Striped Detail Rows -->
                            <VBox styleClass="details-striped-box">
                                <!-- Row 1 -->
                                <HBox alignment="CENTER_LEFT" styleClass="detail-striped-row">
                                    <Label text="Account holder" styleClass="summary-label" prefWidth="180.0"/>
                                    <Label fx:id="lblDetailHolder" text="?" styleClass="summary-value" HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <!-- Row 2 -->
                                <HBox alignment="CENTER_LEFT" styleClass="detail-striped-row">
                                    <Label text="Account number" styleClass="summary-label" prefWidth="180.0"/>
                                    <Label fx:id="lblDetailNumber" text="?" styleClass="summary-value" HBox.hgrow="ALWAYS"/>
                                    <Button text="📋" styleClass="btn-icon-copy" onAction="#copyAccountNumber"/>
                                </HBox>
                                </VBox>

                            <!-- 3 Mini Stats -->
                            <HBox spacing="14.0">
                                <VBox styleClass="mini-stat-card" HBox.hgrow="ALWAYS" spacing="4.0">
                                    <Label text="Current balance" styleClass="mini-stat-label"/>
                                    <Label fx:id="lblStatCurrentBalance" text="0 VND" styleClass="mini-stat-value"/>
                                </VBox>
                                <VBox styleClass="mini-stat-card" HBox.hgrow="ALWAYS" spacing="4.0">
                                    <Label text="Available to spend" styleClass="mini-stat-label"/>
                                    <Label fx:id="lblStatAvailableSpend" text="0 VND" styleClass="mini-stat-value"/>
                                </VBox>

                            </HBox>
                        </VBox>

                        </VBox>

                    <!-- RIGHT COLUMN: Statements Card + Security Lock Card (State Pattern) -->
                    <VBox prefWidth="420.0" spacing="24.0">

                        <!-- Statements Download Card -->
                        <VBox styleClass="card" spacing="16.0">
                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label text="Statements" styleClass="card-title"/>
                                    <Label text="Giao dich thuc tu SQLite" styleClass="card-hint"/>
                                </VBox>
                                <Label text="📄" styleClass="tx-icon"/>
                            </HBox>

                            <Button text="Xuat lich su tai khoan (CSV)" styleClass="btn-secondary-flat" maxWidth="Infinity" onAction="#handleDownloadStatement"/>
                        </VBox>

                        <!-- Security & State Pattern Card (Lock / Unlock Card) -->
                        <VBox styleClass="security-lock-dark-card" spacing="16.0">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <StackPane styleClass="security-shield-pill">
                                    <Label text="🛡" styleClass="shield-icon"/>
                                </StackPane>
                                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label fx:id="lblSecurityLockTitle" text="Need to lock this account?" styleClass="security-dark-title"/>
                                    <Label fx:id="lblSecurityLockDesc" text="Restrict outgoing payments instantly." styleClass="security-dark-desc"/>
                                </VBox>
                            </HBox>

                            <Button fx:id="btnToggleLock" text="🔒  Manage account access" styleClass="btn-white-manage-access" maxWidth="Infinity" onAction="#handleToggleAccountState"/>
                        </VBox>

                    </VBox>

                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
