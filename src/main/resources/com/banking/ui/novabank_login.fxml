<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.banking.ui.NovaBankLoginController"
      prefHeight="720.0" prefWidth="1100.0"
      stylesheets="@novabank.css" styleClass="login-root">

    <!-- ==================== CỘT TRÁI: ART & BRANDING PANEL ==================== -->
    <VBox styleClass="login-art-panel" HBox.hgrow="ALWAYS" prefWidth="540.0" spacing="28.0">
        <padding>
            <Insets top="48.0" right="48.0" bottom="48.0" left="48.0"/>
        </padding>

        <!-- Top Security Badge -->
        <HBox alignment="CENTER_LEFT">
            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="glass-security-pill">
                <SVGPath content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" style="-fx-fill: #00C476;"/>
                <Label text="Hệ thống Ngân hàng Số NovaBank" styleClass="security-pill-text"/>
            </HBox>
        </HBox>

        <!-- Spacer đẩy khối tiêu đề xuống giữa -->
        <Region VBox.vgrow="ALWAYS"/>

        <!-- Middle Headline & Subhead -->
        <VBox spacing="16.0" maxWidth="460.0">
            <Label text="Quản lý tài khoản dễ dàng cùng NovaBank." wrapText="true" styleClass="login-hero-title"/>
            <Label text="Trải nghiệm dịch vụ tài chính thế hệ mới nhanh chóng, an toàn và bảo mật."
                   wrapText="true" styleClass="login-hero-subtitle"/>
        </VBox>

        <!-- Spacer đẩy metrics xuống đáy -->
        <Region VBox.vgrow="ALWAYS"/>

        <!-- Bottom Trust Metrics (3 columns) -->
        <HBox spacing="36.0" alignment="CENTER_LEFT" styleClass="metrics-container">
            <VBox spacing="4.0">
                <Label text="9" styleClass="metric-number"/>
                <Label text="Design Patterns" styleClass="metric-label"/>
            </VBox>
            <VBox spacing="4.0">
                <Label text="SQLite" styleClass="metric-number"/>
                <Label text="Cơ sở dữ liệu an toàn" styleClass="metric-label"/>
            </VBox>
            <VBox spacing="4.0">
                <Label text="VND" styleClass="metric-number"/>
                <Label text="Tiền tệ giao dịch" styleClass="metric-label"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- ==================== CỘT PHẢI: FORM ĐĂNG NHẬP PREMIUM ==================== -->
    <VBox styleClass="login-form-panel" prefWidth="560.0" alignment="CENTER">
        <padding>
            <Insets top="50.0" right="64.0" bottom="50.0" left="64.0"/>
        </padding>

        <VBox spacing="24.0" maxWidth="420.0" alignment="CENTER_LEFT">

            <!-- NovaBank Logo Icon -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="login-logo-circle">
                    <SVGPath content="M3 10h18V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2h14a2 2 0 002-2v-4" style="-fx-fill: transparent; -fx-stroke: white; -fx-stroke-width: 2;"/>
                </StackPane>
                <Label text="NovaBank" styleClass="login-logo-text"/>
            </HBox>

            <!-- Welcome Header -->
            <VBox spacing="6.0">
                <Label text="Chào mừng trở lại" styleClass="login-form-title"/>
                <Label fx:id="lblLoginSubtitle" text="" visible="false" managed="false" styleClass="login-form-subtitle"/>
            </VBox>

            <!-- Error Banner (Real-time validation) -->
            <HBox fx:id="errorBanner" styleClass="transfer-error-box" visible="false" managed="false" alignment="CENTER_LEFT" spacing="12.0">
                <StackPane>
                    <SVGPath content="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" style="-fx-stroke: #EF4444; -fx-stroke-width: 2; -fx-fill: transparent; -fx-stroke-linecap: round; -fx-stroke-linejoin: round;"/>
                </StackPane>
                <Label fx:id="lblError" text="" wrapText="true" styleClass="transfer-error-text" HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Form Fields -->
            <VBox spacing="18.0">
                <!-- Field: Username -->
                <VBox spacing="6.0">
                    <Label text="Tên đăng nhập" styleClass="form-field-label"/>
                    <HBox alignment="CENTER_LEFT" styleClass="input-container">
                        <SVGPath content="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" style="-fx-fill: transparent; -fx-stroke: #94A3B8; -fx-stroke-width: 1.5; -fx-stroke-linecap: round; -fx-stroke-linejoin: round; -fx-scale-x: 0.75; -fx-scale-y: 0.75;"/>
                        <TextField fx:id="txtUsername" promptText="Nhập tên đăng nhập" styleClass="clean-text-input" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <!-- Field: Password -->
                <VBox spacing="6.0">
                    <Label text="Mật khẩu" styleClass="form-field-label"/>
                    <HBox alignment="CENTER_LEFT" styleClass="input-container">
                        <SVGPath content="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" style="-fx-fill: transparent; -fx-stroke: #94A3B8; -fx-stroke-width: 1.5; -fx-stroke-linecap: round; -fx-stroke-linejoin: round; -fx-scale-x: 0.75; -fx-scale-y: 0.75;"/>
                        <StackPane HBox.hgrow="ALWAYS">
                            <PasswordField fx:id="txtPassword" promptText="Nhập mật khẩu" styleClass="clean-text-input"/>
                            <TextField fx:id="txtPasswordPlain" promptText="Nhập mật khẩu" styleClass="clean-text-input" visible="false" managed="false"/>
                        </StackPane>
                        <Button fx:id="btnToggleShowPass" styleClass="btn-show-pass-icon" onAction="#handleTogglePasswordVisibility">
                            <graphic>
                                <SVGPath fx:id="svgEyeIcon" content="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" style="-fx-fill: transparent; -fx-stroke: #94A3B8; -fx-stroke-width: 1.5; -fx-stroke-linecap: round; -fx-stroke-linejoin: round;"/>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Remember Me & Forgot Password -->
                <HBox alignment="CENTER_LEFT">
                    <CheckBox fx:id="chkRememberMe" text="Ghi nhớ đăng nhập" styleClass="checkbox-premium"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Hyperlink text="Quên mật khẩu?" styleClass="link-forgot" onAction="#handleForgotPassword"/>
                </HBox>

                <!-- Sign In Action Button -->
                <Button fx:id="btnSignIn" text="Đăng nhập →" maxWidth="Infinity" styleClass="btn-signin-premium" onAction="#handleSignIn"/>
            </VBox>

        </VBox>
    </VBox>

</HBox>
