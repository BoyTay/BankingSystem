<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.banking.ui.NovaBankHistoryController"
            prefHeight="920.0" prefWidth="1440.0"
            stylesheets="@novabank.css" styleClass="main-window">

    <!-- Sidebar is now managed centrally by NovaBankShell.java -->

    <!-- ==================== 2. MAIN WORKSPACE ==================== -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <VBox spacing="24.0" styleClass="content-container">
                <padding>
                    <Insets top="28.0" right="36.0" bottom="36.0" left="36.0"/>
                </padding>

                <!-- HEADER WITH EXPORT BUTTON -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label text="Transaction history" styleClass="header-greeting"/>
                        <Label text="Search, filter and export every movement across your accounts." styleClass="header-subtitle"/>
                    </VBox>

                    <!-- Right Controls (Export + Undo + Notification + User Pill) -->
                    <HBox alignment="CENTER_RIGHT" spacing="14.0">
                        <Button fx:id="btnUndo" text="↶ Undo Last (Command)" styleClass="btn-danger-flat" onAction="#handleUndo"/>
                        <Button fx:id="btnExport" text="⤓  Export" styleClass="btn-secondary-flat" onAction="#handleExportCsv"/>
                        <Button styleClass="icon-btn-round" text="🔔"/>
                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="user-profile-pill">
                            <StackPane styleClass="avatar-circle">
                                <Label text="AM" styleClass="avatar-text"/>
                            </StackPane>
                            <VBox spacing="2.0">
                                <Label text="Current user" styleClass="user-name"/>
                                <Label text="Local operator" styleClass="user-tier"/>
                            </VBox>
                            <Label text="▾" styleClass="user-chevron"/>
                        </HBox>
                    </HBox>
                </HBox>

                <!-- ROW 1: 3 KPI CARDS (Money In, Money Out, Pending) -->
                <HBox spacing="20.0">

                    <!-- KPI 1: Money In -->
                    <VBox styleClass="kpi-metric-card" HBox.hgrow="ALWAYS" spacing="12.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Money in" styleClass="kpi-label" HBox.hgrow="ALWAYS"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <StackPane styleClass="kpi-icon-pill,kpi-pill-green">
                                <Label text="↙" styleClass="kpi-arrow-green"/>
                            </StackPane>
                        </HBox>
                        <Label fx:id="lblMoneyIn" text="0 VND" styleClass="kpi-amount"/>
                    </VBox>

                    <!-- KPI 2: Money Out -->
                    <VBox styleClass="kpi-metric-card" HBox.hgrow="ALWAYS" spacing="12.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Money out" styleClass="kpi-label" HBox.hgrow="ALWAYS"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <StackPane styleClass="kpi-icon-pill,kpi-pill-gray">
                                <Label text="↗" styleClass="kpi-arrow-gray"/>
                            </StackPane>
                        </HBox>
                        <Label fx:id="lblMoneyOut" text="0 VND" styleClass="kpi-amount"/>
                    </VBox>

                    <!-- KPI 3: Pending -->
                    <VBox styleClass="kpi-metric-card" HBox.hgrow="ALWAYS" spacing="12.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Pending" styleClass="kpi-label" HBox.hgrow="ALWAYS"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <StackPane styleClass="kpi-icon-pill,kpi-pill-amber">
                                <Label text="⏱" styleClass="kpi-arrow-amber"/>
                            </StackPane>
                        </HBox>
                        <Label fx:id="lblPendingAmount" text="0 VND" styleClass="kpi-amount"/>
                        <HBox alignment="CENTER_LEFT" spacing="4.0">
                            <Label fx:id="lblPendingCount" text="Không có giao dịch chờ" styleClass="kpi-trend-amber"/>
                        </HBox>
                    </VBox>

                </HBox>

                <!-- ROW 2: SEARCH & TABLE CONTAINER (Main Card) -->
                <VBox styleClass="card" spacing="16.0">

                    <!-- Search Input Row -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="table-search-bar">
                        <Label text="🔍" styleClass="input-icon"/>
                        <TextField fx:id="txtSearch" promptText="Search merchant, reference or amount" styleClass="clean-text-input" HBox.hgrow="ALWAYS"/>
                        <Region HBox.hgrow="NEVER" prefWidth="12.0"/>
                        <Label fx:id="lblTransactionCount" text="0 transactions" styleClass="tx-count-label"/>
                    </HBox>

                    <!-- Filter Dropdowns Row -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <ComboBox fx:id="cbDateFilter" promptText="Date: All time" styleClass="filter-dropdown-pill"/>
                        <ComboBox fx:id="cbTypeFilter" promptText="Type: All types" styleClass="filter-dropdown-pill"/>
                        <ComboBox fx:id="cbAmountFilter" promptText="Amount: Any amount" styleClass="filter-dropdown-pill"/>
                        <ComboBox fx:id="cbAccountFilter" promptText="Account: All accounts" styleClass="filter-dropdown-pill"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Hyperlink text="Clear filters" styleClass="link-clear-filter" onAction="#handleClearFilters"/>
                    </HBox>

                    <!-- Modern Transactions Table -->
                    <TableView fx:id="tableTransactions" prefHeight="440.0" styleClass="novabank-table">
                        <columns>
                            <TableColumn fx:id="colDate" text="DATE" prefWidth="170.0"/>
                            <TableColumn fx:id="colTypeAccount" text="TYPE &amp; ACCOUNT" prefWidth="230.0"/>
                            <TableColumn fx:id="colDescription" text="DESCRIPTION" prefWidth="320.0"/>
                            <TableColumn fx:id="colStatus" text="STATUS" prefWidth="150.0"/>
                            <TableColumn fx:id="colAmount" text="AMOUNT" prefWidth="170.0"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
